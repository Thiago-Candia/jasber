# Copiar a .env (o definir en el panel de Railway). Nunca subir valores reales.
DJANGO_DEBUG=true
# Obligatoria con DJANGO_DEBUG=false. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Opcional: clave distinta para firmar los JWT (por defecto usa SECRET_KEY).
JWT_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1
# Origen del frontend (CORS, WebSocket y link del mail de recuperación).
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Sin DATABASE_URL se usa SQLite local. Railway la inyecta con el plugin de PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jasber_development
# Sin REDIS_URL el tiempo real usa una capa en memoria (solo sirve con un proceso).
REDIS_URL=
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
MAX_ATTACHMENT_SIZE_MB=10
MAX_ATTACHMENTS_PER_MESSAGE=10
MAX_IMAGE_SIZE_MB=5
# Por defecto: adjuntos * cantidad + 1 MB.
MAX_REQUEST_SIZE_MB=
BLOCKED_ATTACHMENT_EXTENSIONS=.exe,.msi,.bat,.cmd,.com,.scr,.ps1,.vbs,.js,.jar,.sh,.dll
SECURE_HSTS_SECONDS=0
# SMTP (sin EMAIL_HOST los mails se imprimen en la consola).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@jasber.test
